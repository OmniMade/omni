# Control-plane image: workspace source + pnpm; the server runs via tsx.
FROM node:22-bookworm-slim

corepack enable
WORKDIR /app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/server/package.json apps/server/
COPY packages/aep/package.json packages/aep/
RUN pnpm install --frozen-lockfile --filter @omni/server

COPY tsconfig.base.json ./
COPY packages/aep packages/aep
COPY apps/server apps/server

WORKDIR /app/apps/server
ENV NODE_ENV=production
EXPOSE 3000
CMD ["pnpm", "start"]
