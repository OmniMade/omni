{
  "name": "@omni/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./runtime": "./src/runtime.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/node-ws": "^1.3.1",
    "@node-rs/argon2": "^2.2.0",
    "@omni/aep": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "postgres": "^3.4.9",
    "uuidv7": "^1.2.1",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@omni/hostd": "workspace:*",
    "@types/node": "^26.4.1",
    "@types/ws": "latest",
    "drizzle-kit": "^0.31.10",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
