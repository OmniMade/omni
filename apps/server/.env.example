# Control plane configuration (copy to .env for local dev)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/omni
PORT=3000
# Apply pending migrations on boot (dev convenience; pnpm db:migrate otherwise)
AUTO_MIGRATE=true
# 32+ bytes hex; when unset a per-boot random is used (sessions don't survive restarts)
SESSION_SECRET=
# Public base URL used when printing the omni-hostd connect command (set when
# behind a reverse proxy / tailscale serve, e.g. https://omni.tailnet-name.ts.net)
PUBLIC_URL=
# Host channel tuning
HEARTBEAT_INTERVAL_SEC=30
HEARTBEAT_MISSES=3
OFFLINE_SWEEP_SEC=10
# Enrollment token lifetime
ENROLL_TOKEN_TTL_MIN=15
